# MapTiler API Configuration
REACT_APP_MAPTILER_API_KEY=your_maptiler_api_key_here

# Flask Configuration
FLASK_ENV=production
PORT=5000

# WAQI (World Air Quality Index) API
WAQI_API_KEY=your_waqi_api_key_here

# Optional: Custom city configurations
# CITY=bangalore
# DEFAULT_LAT=12.9716
# DEFAULT_LNG=77.5946
# DEFAULT_ZOOM=12

# Production Settings
PYTHONUNBUFFERED=1
